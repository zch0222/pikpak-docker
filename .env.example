# 复制成 .env 后按需修改

# 容器名，脚本也用它找容器
PIKPAK_CONTAINER=pikpak

# PikPak 安装包的 sha256，下面是 2.15.2 的值。官方下载地址总是最新版，这个值决定用哪个版本：
# 官方出了新版时构建会因为对不上而失败，确认要升级就改成新值；留空则只打印、不校验。
# 也可以把安装包 official_PikPak.exe 放进 vendor/ 目录，就不用下载
PIKPAK_SHA256=37eb31b25192a7db6ad8ea9607c28a68718bc8b9cbca8edf6c0b4306fa76496b

# WineHQ 稳定版的包版本号
WINE_VERSION=11.0.0.0~noble-1

# 构建时用的 Ubuntu 镜像源，留空用官方源。国内服务器建议填，例如：
# APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/ubuntu
# 要用 http：这一步时镜像里还没有 CA 证书，https 会校验失败；软件包由 apt 的签名保证完整
APT_MIRROR=

# noVNC 控制密码（必填）。VNC 协议只取前 8 个字符
VNC_PASSWORD=
# noVNC 只读密码（可选），用它登录只能看、不能操作
VNC_VIEW_PASSWORD=

# noVNC 监听地址和端口。默认只监听本机，远程访问用 SSH 隧道或反向代理。
# 默认 6082，和 life115-docker 的 6080 错开，两个可以在同一台机器上运行
NOVNC_BIND=127.0.0.1
NOVNC_PORT=6082

# 和客户端交换文件的宿主机目录，读写挂载到容器的 /data，在客户端里是 Z:\data
HOST_DATA_DIR=./data

# v2ray 代理开关。true：客户端的全部连接都经过 v2ray，节点配置写在 v2ray/v2ray.json
# （从 v2ray/v2ray.example.json 复制）；false：直连。改完执行 docker compose up -d 生效
V2RAY_ENABLED=false
# v2ray（v2fly/v2ray-core）版本和安装包 sha256，下面是 5.53.0 的值；换版本时一起改
# 也可以把 v2ray-linux-64.zip 放进 vendor/ 目录，就不用下载
V2RAY_VERSION=5.53.0
V2RAY_SHA256=6bbb8aee65a57d0b12599b4b7c842b3ad0daca4436e661d94015c447cb31b4fa

# 虚拟显示器分辨率和色深
SCREEN_GEOMETRY=1600x900x24

TZ=Asia/Shanghai
