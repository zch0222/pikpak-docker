#!/bin/sh
# 截取虚拟显示器的画面
# 参数是输出文件，默认 /tmp/screenshot.png；"-" 表示把 PNG 写到标准输出
set -eu
. /usr/local/lib/pikpak/common.sh

out=${1:-/tmp/screenshot.png}
tmp="$(mktemp -u /tmp/shot.XXXXXX).png"
# sh 没有 pipefail，中间哪一步失败都只能从结果判断
if ! xwd -root -silent -display "$DISPLAY" | xwdtopnm 2>/dev/null | pnmtopng > "$tmp" || [ ! -s "$tmp" ]; then
    rm -f "$tmp"
    die "截图失败，X 服务 $DISPLAY 可能没有运行"
fi
if [ "$out" = "-" ]; then
    cat "$tmp"
    rm -f "$tmp"
else
    mv "$tmp" "$out"
    echo "$out"
fi
